# Server
PORT=4000
NODE_ENV=development
BACKEND_URL=http://localhost:4000

# Shopify Store domain (without https://)
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com

# Shopify App Credentials (from Shopify Partners / Dev Dashboard)
SHOPIFY_ADMIN_API_KEY=your-client-id
SHOPIFY_ADMIN_API_SECRET=your-client-secret

# Access Token — choose ONE approach:
#
# Option A (Dev Dashboard / OAuth):
#   Leave this blank. The token is obtained automatically when
#   you visit http://localhost:4000/api/auth/shopify
#
# Option B (Custom App / static token):
#   Paste your shpat_ token here directly.
#
SHOPIFY_ADMIN_ACCESS_TOKEN=

# Shopify Webhook secret (for verifying webhook signatures)
SHOPIFY_WEBHOOK_SECRET=

# Frontend origin (for CORS)
FRONTEND_URL=http://localhost:5173
